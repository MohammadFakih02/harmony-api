      - "7880:7880"
      - "7881:7881"
      - "7882:7882/udp"
    volumes:
      - ./configs/livekit.yaml:/etc/livekit.yaml
    command: --config /etc/livekit.yaml

volumes:
  postgres_data:
  scylla_data:
  minio_data:
